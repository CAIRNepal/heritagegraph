# SELECT (COUNT(*) AS ?triples) WHERE {
#   GRAPH <https://data.cair-nepal.org/heritagegraph/graph/unesco> { ?s ?p ?o }
# }

# CQ9 — Federated-style: L1 resource linked to external OSM via seeAlso/exactMatch
# (Requires L1 materialization + identity cluster projection.)
# SELECT ?s ?ext WHERE {
