#     ?s ?p ?o .
#     FILTER(STRSTARTS(STR(?s), "https://data.cair-nepal.org/"))
#   }
# }

# CQ7 — Label language coverage (Nepali vs English) in L0
# SELECT ?lang (COUNT(*) AS ?n) WHERE {
#   GRAPH <https://data.cair-nepal.org/heritagegraph/graph/openstreetmap> {
#     ?s rdfs:label ?label .
#     BIND(LANG(?label) AS ?lang)
#   }
# }
# GROUP BY ?lang ORDER BY DESC(?n)

