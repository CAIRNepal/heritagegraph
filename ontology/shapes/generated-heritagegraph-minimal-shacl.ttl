@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix hg: <https://w3id.org/heritagegraph/shacl#> .

hg:assertionShape a sh:NodeShape ;
  rdfs:label "Shape for registry class assertion" ;
  sh:targetClass <https://w3id.org/heritagegraph/I2_Belief> ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#value> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserts_about_entity> ;
      sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserts_about_event> ;
      sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#wasDerivedFrom> ;
      sh:nodeKind sh:IRI ;
      sh:minCount 1 ;
    ] ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#wasAttributedTo> ;
      sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/confidenceScore> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/dataQualityNote> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/reconciliationStatus> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/J4_that> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/J2_concluded_that> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserted_property> ;
      sh:nodeKind sh:Literal ;
      sh:minCount 1 ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserted_value> ;
      sh:nodeKind sh:Literal ;
      sh:minCount 1 ;
    ] ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#wasRevisionOf> ;
      sh:nodeKind sh:IRI ;
    ]  .

