hg:assertionShape a sh:NodeShape ;
  rdfs:label "Shape for registry class assertion" ;
  sh:targetClass <https://w3id.org/heritagegraph/I2_Belief> ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#value> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserts_about_entity> ;
      sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserts_about_event> ;
      sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#wasDerivedFrom> ;
      sh:nodeKind sh:IRI ;
      sh:minCount 1 ;
    ] ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#wasAttributedTo> ;
      sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#generatedAtTime> ;
      sh:nodeKind sh:Literal ;
      sh:minCount 1 ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/confidence_score> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/data_quality_note> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/reconciliation_status> ;
      sh:nodeKind sh:Literal ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserted_property> ;
      sh:nodeKind sh:Literal ;
      sh:minCount 1 ;
    ] ;
    sh:property [
      sh:path <https://w3id.org/heritagegraph/asserted_value> ;
      sh:nodeKind sh:Literal ;
      sh:minCount 1 ;
    ] ;
    sh:property [
      sh:path <http://www.w3.org/ns/prov#invalidated> ;
      sh:nodeKind sh:IRI ;
    ]  .

