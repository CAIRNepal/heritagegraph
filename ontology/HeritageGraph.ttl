heritageGraph:start_place a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "start_place" ;
    rdfs:range heritageGraph:Place ;
    skos:definition "Starting location of movement ritual" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:started_at_time a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "started_at_time" ;
    rdfs:range linkml:Datetime ;
    skos:definition "Time at which this activity started." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:syncretic_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "syncretic_type" ;
    rdfs:range heritageGraph:SyncreticType ;
    rdfs:subPropertyOf heritageGraph:has_type ;
    skos:definition "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:traditional_role a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "traditional_role" ;
    rdfs:range linkml:String ;
    skos:definition "Hereditary occupation or ritual duty" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:transferred_from_actor a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transferred_from_actor" ;
    rdfs:range heritageGraph:Actor ;
    skos:definition "Previous custodian" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:transferred_object a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transferred_object" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Object transferred in custody event" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:transferred_to_guthi a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transferred_to_guthi" ;
    rdfs:range heritageGraph:Guthi ;
    rdfs:subPropertyOf heritageGraph:transferred_to_actor ;
    skos:definition "New custodian (Guthi)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:used_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "used_method" ;
    rdfs:range linkml:String ;
    skos:definition "Documentation method used" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:verification_method a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "verification_method" ;
    rdfs:range linkml:String ;
    skos:definition "Method used for verification (cross-check, expert review, field visit)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:wktLiteral a owl:Class,
        linkml:TypeDefinition ;
    rdfs:subClassOf linkml:String .

heritageGraph:year_offset_from_gregorian a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "year_offset_from_gregorian" ;
    rdfs:range linkml:Integer ;
    skos:definition "Mathematical offset to convert to Common Era (e.g., +57 for BS)." ;
    skos:inScheme heritageGraph:schema .

aat:300007576 a owl:Class,
        heritageGraph:ArchitecturalStyle ;
    rdfs:label "Stupa" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStyle .

heritageGraph:ArchitecturalElement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ArchitecturalElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:is_component_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:is_component_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_component_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:Entity ;
    skos:broadMatch crm:E25_Human-Made_Feature ;
    skos:definition "Carved or constructed component of an architectural structure (e.g., Gajur, Torana, Tundal)" ;
    skos:exactMatch aat:300000885,
        heritageGraph:ArchitecturalElement ;
    skos:inScheme heritageGraph:schema .

heritageGraph:CalendarSystem a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "CalendarSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:Integer ;
            owl:onProperty heritageGraph:year_offset_from_gregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:epoch_date_gregorian ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:year_offset_from_gregorian ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:is_primary_for_tradition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:year_offset_from_gregorian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_primary_for_tradition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:epoch_date_gregorian ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:epoch_date_gregorian ],
        heritageGraph:Entity ;
    skos:broadMatch time:TRS ;
    skos:definition "Calendar reckoning system with conversion rules for multi-calendar temporal reasoning" ;
    skos:exactMatch heritageGraph:CalendarSystem ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ConditionAssessment a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ConditionAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:assessed_condition_state ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty heritageGraph:assessed_object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:assessed_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ConditionState ;
            owl:onProperty heritageGraph:assessed_condition_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assessed_object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assessed_condition_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        heritageGraph:Activity ;
    skos:definition "Event of evaluating the physical state of a heritage object or structure" ;
    skos:exactMatch crm:E14_Condition_Assessment ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:Consecration a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Consecration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:makes_deity_present ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Murti ;
            owl:onProperty heritageGraph:consecrated_object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:makes_deity_present ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:consecrated_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:makes_deity_present ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:consecrated_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        heritageGraph:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)" ;
    skos:exactMatch heritageGraph:Consecration ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:Proposition a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Proposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:proposition_subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:proposition_object_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty heritageGraph:proposition_predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:proposition_object_literal ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:proposition_object_entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:proposition_predicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:proposition_subject ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:proposition_predicate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:proposition_object_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:proposition_object_literal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:proposition_subject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:proposition_object_literal ],
        heritageGraph:Entity ;
    skos:broadMatch crminf:I4_Proposition_Set ;
    skos:closeMatch rdf:Statement ;
    skos:definition "A single machine-readable proposition (subject - predicate - object) held true by an Assertion. Modelled as a singleton proposition set (CRMinf I4); the predicate is a URI/CURIE, the object either a heritage entity or a literal." ;
    skos:exactMatch heritageGraph:Proposition ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RestHouse a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RestHouse" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Community structures for travelers and pilgrims, maintained by Guthi organizations" ;
    skos:exactMatch heritageGraph:RestHouse ;
    skos:inScheme heritageGraph:schema .

heritageGraph:asserts_about a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asserts_about" ;
    rdfs:range heritageGraph:AssertionSubject ;
    owl:inverseOf heritageGraph:has_assertion ;
    skos:definition "Heritage entity or event that is the subject of this assertion." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:consecrated_by_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "consecrated_by_event" ;
    rdfs:range heritageGraph:Consecration ;
    owl:inverseOf heritageGraph:consecrated_object ;
    skos:definition "Consecration event that activated this murti" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:consecrated_object a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "consecrated_object" ;
    rdfs:range heritageGraph:Murti ;
    owl:inverseOf heritageGraph:consecrated_by_event ;
    skos:definition "Murti employed in (and transformed by) the consecration ritual" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:documented_in_source a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "documented_in_source" ;
    rdfs:range heritageGraph:DataSource ;
    skos:definition "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment "prov:wasInfluencedBy" .

heritageGraph:enshrined_deity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "enshrined_deity" ;
    rdfs:range heritageGraph:Deity ;
    rdfs:subPropertyOf heritageGraph:occurred_in_presence_of ;
    owl:inverseOf heritageGraph:is_enshrined_through_event ;
    skos:definition "Deity installed through enshrinement" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrined_in_structure a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "enshrined_in_structure" ;
    rdfs:range heritageGraph:Temple ;
    rdfs:subPropertyOf heritageGraph:ritual_on_structure ;
    owl:inverseOf heritageGraph:enshrines_deity_through_event ;
    skos:definition "Temple where deity was enshrined" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:existence_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "existence_status" ;
    rdfs:range heritageGraph:ExistenceStatus ;
    skos:definition "Current physical status of the structure" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:had_participant a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "had_participant" ;
    rdfs:range heritageGraph:Actor ;
    skos:definition "Actor(s) participating in this period or situation (e.g. the girl holding a Kumari tenure)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:has_condition_assessment a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_condition_assessment" ;
    rdfs:range heritageGraph:ConditionAssessment ;
    skos:definition "Condition assessment events for this structure" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:has_provenance_assertion a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_provenance_assertion" ;
    rdfs:range heritageGraph:HeritageAssertion ;
    skos:definition "Sourced statements about this item — who claimed what, and where it is documented. Optional for most contributors." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:ui_example "Founded in the 17th century (source: National Archives, ref. 2014/231)" ;
    heritageGraph:ui_help "A provenance assertion is a single sourced claim about this item (for example: 'Built in 1427, according to Slusser 1982'). You can leave this empty — reviewers and curators usually add assertions during review. Add one only if you have a specific source to cite." .

heritageGraph:includes_ritual_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "includes_ritual_event" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Component rituals of festival" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:participates_in_ritual a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "participates_in_ritual" ;
    rdfs:range heritageGraph:RitualEvent ;
    rdfs:subPropertyOf heritageGraph:was_present_at ;
    skos:definition "Rituals in which this structure participates" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:retired_through a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "retired_through" ;
    rdfs:range heritageGraph:KumariRetirementEvent ;
    owl:inverseOf heritageGraph:ended_tenure_of ;
    skos:definition "Retirement/desanctification event that ended this tenure." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ritual_on_structure a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ritual_on_structure" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Ritual occurs at specific temple or monument" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:selected_through a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "selected_through" ;
    rdfs:range heritageGraph:KumariSelectionEvent ;
    owl:inverseOf heritageGraph:initiated_tenure ;
    skos:definition "Selection event that initiated this tenure." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:supported_by_institution a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supported_by_institution" ;
    rdfs:range heritageGraph:Guthi ;
    skos:definition "Institution(s) providing economic support (stipend, land endowment) or ritual support (priest salaries) for a Living Goddess during tenure. Extends Guthi role beyond structure management to person support." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:transferred_to_actor a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "transferred_to_actor" ;
    rdfs:range heritageGraph:Actor ;
    skos:definition "New custodian (person or group)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:used a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "used" ;
    rdfs:range heritageGraph:Entity ;
    skos:definition "Entity used by this activity." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:was_associated_with a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_associated_with" ;
    rdfs:range heritageGraph:Agent ;
    skos:definition "Agent associated with responsibility for this activity." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:was_attributed_to a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_attributed_to" ;
    rdfs:range heritageGraph:Agent ;
    skos:definition "Agent to whom responsibility for this entity is attributed." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:was_derived_from a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_derived_from" ;
    rdfs:range heritageGraph:Entity ;
    skos:definition "Entity from which this entity was derived." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariLifecycleEvent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "KumariLifecycleEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:bounds_tenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariTenure ;
            owl:onProperty heritageGraph:bounds_tenure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:bounds_tenure ],
        heritageGraph:RitualEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Abstract event that bounds a KumariTenure (selection, enthronement, or retirement). Each concrete subclass requires exactly one tenure edge via slot_usage: initiated_tenure (selection), ended_tenure_of (retirement), or bounds_tenure itself (enthronement)." ;
    skos:exactMatch heritageGraph:KumariLifecycleEvent ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariSelectionEvent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "KumariSelectionEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:selected_person ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:SelectionCriterion ;
            owl:onProperty heritageGraph:has_criterion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Assertion ;
            owl:onProperty heritageGraph:has_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariTenure ;
            owl:onProperty heritageGraph:initiated_tenure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:confers_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] heritageGraph:Actor ) ] ;
            owl:onProperty heritageGraph:performed_by_group ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Boolean ;
            owl:onProperty heritageGraph:is_critical_for_festival ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:initiated_tenure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:confers_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:selected_person ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_critical_for_festival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_criterion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:initiated_tenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:selected_person ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRole ;
            owl:onProperty heritageGraph:confers_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_critical_for_festival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performed_by_group ],
        heritageGraph:KumariLifecycleEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer." ;
    skos:exactMatch heritageGraph:KumariSelectionEvent ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:Production a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Production" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:produced_object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Assertion ;
            owl:onProperty heritageGraph:has_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Technique ;
            owl:onProperty heritageGraph:used_technique ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:commissioned_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty heritageGraph:produced_object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:produced_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:commissioned_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used_technique ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:Activity ;
    skos:definition "Event of creating an architectural structure, murti, or paubha" ;
    skos:exactMatch crm:E12_Production ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:ReligiousStructure a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReligiousStructure" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Architectural structure whose defining purpose is religious: enshrines a deity and/or is a locus of ritual activation. Abstract grouping for sacred structures across traditions (temple, stupa, chaitya)." ;
    skos:exactMatch heritageGraph:ReligiousStructure ;
    skos:inScheme heritageGraph:schema .

heritageGraph:generated a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "generated" ;
    rdfs:range heritageGraph:Entity ;
    owl:inverseOf heritageGraph:was_generated_by ;
    skos:definition "Entity generated by this activity." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Enshrinement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Enshrinement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:enshrined_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_in_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Temple ;
            owl:onProperty heritageGraph:enshrined_in_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_in_structure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_deity ],
        heritageGraph:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Event of installing a deity's murti or symbol within a temple sanctum" ;
    skos:exactMatch heritageGraph:Enshrinement ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:Festival a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Festival" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:includes_ritual_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:includes_ritual_event ],
        heritageGraph:RitualEvent ;
    skos:altLabel "Jatra" ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
    skos:exactMatch heritageGraph:Festival ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:IconographicObject a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "IconographicObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_produced_by_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Production ;
            owl:onProperty heritageGraph:was_produced_by_event ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:depicts_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_current_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:participates_in_ritual ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:used_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:depicts_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:has_current_location ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:participates_in_ritual ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:was_produced_by_event ],
        heritageGraph:HumanMadeObject ;
    skos:broadMatch dbo:Artwork,
        crm:E22_Human-Made_Object ;
    skos:closeMatch crm:E36_Visual_Item ;
    skos:definition "Sacred visual art objects that depict or embody deities through iconographic conventions" ;
    skos:exactMatch heritageGraph:IconographicObject ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ReligiousTradition a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ReligiousTradition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:Entity ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "Religious or philosophical tradition (e.g., Hindu, Buddhist, Syncretic)" ;
    skos:exactMatch aat:300073708,
        heritageGraph:ReligiousTradition ;
    skos:inScheme heritageGraph:schema .

heritageGraph:archival_location a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "archival_location" ;
    rdfs:range linkml:String ;
    skos:definition "Where stored (e.g., National Museum Kathmandu, British Library, URL)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assertion_content a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assertion_content" ;
    rdfs:range linkml:String ;
    skos:definition "The factual claim being asserted" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:confers_role a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "confers_role" ;
    rdfs:range heritageGraph:KumariRole ;
    skos:definition "KumariRole conferred by this selection or enthronement event." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:confidence_score a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "confidence_score" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( linkml:Float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
    skos:definition "Reliability score for assertion (0.0-1.0)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:data_quality_note a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "data_quality_note" ;
    rdfs:range linkml:String ;
    skos:definition "Notes on data quality, completeness, or uncertainty" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:embodied_deity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "embodied_deity" ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Deity role embodied by participant" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:has_architectural_style a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_architectural_style" ;
    rdfs:range heritageGraph:ArchitecturalStyle ;
    rdfs:subPropertyOf heritageGraph:has_type ;
    skos:definition "Architectural style classification" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:has_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_type" ;
    skos:definition "Generic CRM typing property (P2 has type). Canonical holder of the CRM predicate; use the specific typing slots below in data." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:is_critical_for_festival a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "is_critical_for_festival" ;
    rdfs:range linkml:Boolean ;
    skos:definition "Whether this ritual is essential for the festival's completion" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:place_coordinates a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "place_coordinates" ;
    rdfs:range heritageGraph:wktLiteral ;
    skos:definition "Coordinates as WKT literal" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:reconciliation_status a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "reconciliation_status" ;
    rdfs:range linkml:String ;
    skos:definition "Status of multi-source reconciliation (confirmed, conflicting, unverified)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:residence_structure a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "residence_structure" ;
    rdfs:range heritageGraph:ArchitecturalStructure ;
    skos:definition "Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:selected_person a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "selected_person" ;
    rdfs:range heritageGraph:Person ;
    skos:definition "Person selected through a ritual selection process to assume a sacred role or office" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:source_language a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_language" ;
    rdfs:range linkml:String ;
    skos:definition "Language of the source material" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:source_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_type" ;
    rdfs:range linkml:String ;
    skos:definition "Type of source: Manuscript, Inscription, FieldSurvey, PublishedBook, Archive, MuseumCollection, OralHistoryInterview, etc." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:supersedes_assertion a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "supersedes_assertion" ;
    rdfs:range heritageGraph:Assertion ;
    skos:definition "Previous assertion that this one revises (version chain A1->A2->A3). Uses prov:wasRevisionOf (a derivation between entities); the latest assertion is the one with no incoming wasRevisionOf. NOTE: prov:invalidated was incorrect here (it is an Activity->Entity relation, not Entity->Entity)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariRole a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "KumariRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:role_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:role_deity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:role_deity ],
        heritageGraph:Entity ;
    skos:altLabel "Living Goddess",
        "Royal Kumari" ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder." ;
    skos:exactMatch heritageGraph:KumariRole ;
    skos:inScheme heritageGraph:schema .

heritageGraph:initiated_tenure a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "initiated_tenure" ;
    rdfs:range heritageGraph:KumariTenure ;
    rdfs:subPropertyOf heritageGraph:bounds_tenure ;
    owl:inverseOf heritageGraph:selected_through ;
    skos:definition "Kumari tenure that was initiated by this selection event" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:was_influenced_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_influenced_by" ;
    rdfs:range [ owl:unionOf ( heritageGraph:Entity heritageGraph:Activity heritageGraph:Agent ) ] ;
    skos:definition "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:CasteGroup a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "CasteGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:traditional_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:traditional_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:traditional_role ],
        heritageGraph:Actor ;
    skos:broadMatch crm:E74_Group,
        prov:Organization ;
    skos:definition "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    skos:exactMatch heritageGraph:CasteGroup ;
    skos:inScheme heritageGraph:schema .

heritageGraph:bounds_tenure a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "bounds_tenure" ;
    rdfs:range heritageGraph:KumariTenure ;
    skos:definition "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ended_tenure_of a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ended_tenure_of" ;
    rdfs:range heritageGraph:KumariTenure ;
    rdfs:subPropertyOf heritageGraph:bounds_tenure ;
    owl:inverseOf heritageGraph:retired_through ;
    skos:definition "Points from a KumariRetirementEvent to the tenure that it terminated. Enables reconstruction of the complete Kumari lifecycle." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariTenure a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "KumariTenure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enthroned_through ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:retired_through ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:had_participant ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:residence_structure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:selected_through ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:retired_through ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:had_participant ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:supported_by_institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assumes_role ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:residence_structure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:residence_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRetirementEvent ;
            owl:onProperty heritageGraph:retired_through ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:selected_through ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRole ;
            owl:onProperty heritageGraph:assumes_role ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariSelectionEvent ;
            owl:onProperty heritageGraph:selected_through ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enthroned_through ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:embodied_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:supported_by_institution ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:embodied_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:assumes_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:embodied_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariEnthronementEvent ;
            owl:onProperty heritageGraph:enthroned_through ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:Entity ;
    skos:altLabel "Living Goddess Tenure" ;
    skos:broadMatch crm:E4_Period ;
    skos:definition "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families." ;
    skos:exactMatch heritageGraph:KumariTenure ;
    skos:inScheme heritageGraph:schema .

heritageGraph:SelectionCriterion a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "SelectionCriterion" ;
    rdfs:subClassOf heritageGraph:Entity ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text." ;
    skos:exactMatch heritageGraph:SelectionCriterion ;
    skos:inScheme heritageGraph:schema .

heritageGraph:generated_at_time a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "generated_at_time" ;
    rdfs:range linkml:Datetime ;
    skos:definition "Time at which this entity was generated (ISO 8601)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:was_produced_by_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_produced_by_event" ;
    rdfs:range heritageGraph:Production ;
    skos:definition "Event that created this object or structure" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ConditionType a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( heritageGraph:Good heritageGraph:Damaged heritageGraph:Ruined heritageGraph:Restored ) ;
    linkml:permissible_values heritageGraph:Damaged,
        heritageGraph:Good,
        heritageGraph:Restored,
        heritageGraph:Ruined .

heritageGraph:PhysicalHeritageThing a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "PhysicalHeritageThing" ;
    rdfs:subClassOf heritageGraph:Entity ;
    skos:definition "Union of the tangible heritage classes: architectural structures, iconographic objects, and standalone architectural elements. Used as the range of slots that apply to any physical heritage thing (production, custody, condition assessment)." ;
    skos:exactMatch heritageGraph:PhysicalHeritageThing ;
    skos:inScheme heritageGraph:schema .

heritageGraph:SyncreticType a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( heritageGraph:Equivalence heritageGraph:Appropriation heritageGraph:Fusion heritageGraph:Historical ) ;
    linkml:permissible_values heritageGraph:Appropriation,
        heritageGraph:Equivalence,
        heritageGraph:Fusion,
        heritageGraph:Historical .

heritageGraph:has_current_location a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_current_location" ;
    rdfs:range heritageGraph:Place ;
    skos:definition "Current location of object or structure" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:performed_by_group a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "performed_by_group" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] heritageGraph:Actor ) ] ;
    rdfs:subPropertyOf heritageGraph:carried_out_by ;
    skos:definition "Group (Guthi, caste) responsible for ritual" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:was_generated_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_generated_by" ;
    rdfs:range heritageGraph:Activity ;
    owl:inverseOf heritageGraph:generated ;
    skos:definition "Activity that generated this entity." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:AssertionSubject a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "AssertionSubject" ;
    skos:broadMatch crm:E1_CRM_Entity ;
    skos:definition "Any HeritageGraph entity or event that may be the subject of an assertion." ;
    skos:exactMatch heritageGraph:AssertionSubject ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DataSource a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DataSource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:datacite_publisher ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:datacite_identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:archival_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:source_citation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:datacite_publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:publication_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:datacite_creator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_citation ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:datacite_publisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:datacite_resource_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:source_citation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:source_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:datacite_identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:datacite_resource_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:archival_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:datacite_creator ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:source_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:publication_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:datacite_identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:datacite_identifier_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:source_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:datacite_identifier_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:datacite_resource_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:datacite_identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:archival_location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:publication_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:Entity ;
    skos:broadMatch crm:E73_Information_Object ;
    skos:definition "Original source from which heritage information was derived" ;
    skos:exactMatch heritageGraph:DataSource ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DatePrecision a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( heritageGraph:Exact heritageGraph:Year heritageGraph:Decade heritageGraph:Century heritageGraph:Circa ) ;
    linkml:permissible_values heritageGraph:Century,
        heritageGraph:Circa,
        heritageGraph:Decade,
        heritageGraph:Exact,
        heritageGraph:Year .

heritageGraph:Agent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( heritageGraph:Entity heritageGraph:Activity heritageGraph:Agent ) ] ;
            owl:onProperty heritageGraph:was_influenced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:acted_on_behalf_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Agent ;
            owl:onProperty heritageGraph:acted_on_behalf_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_influenced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:id ] ;
    skos:definition "Direct LinkML representation of prov:Agent. Agents bear responsibility for activities or entities. PROV-O permits an individual agent also to be typed as an Entity, but does not define every Agent as a subclass of Entity." ;
    skos:exactMatch prov:Agent ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ArchitecturalStyle a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( aat:300004829 <https://w3id.org/heritagegraph/ArchitecturalStyle#Shikhara> aat:300001280 aat:300007562 aat:300007576 ) ;
    linkml:permissible_values aat:300001280,
        aat:300004829,
        aat:300007562,
        aat:300007576,
        <https://w3id.org/heritagegraph/ArchitecturalStyle#Shikhara> .

heritageGraph:Assertion a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Assertion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:asserts_about ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:reconciliation_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_generated_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:confidence_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:reconciliation_status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:asserts_about ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:supersedes_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Agent ;
            owl:onProperty heritageGraph:was_attributed_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Proposition ;
            owl:onProperty heritageGraph:asserts_proposition ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_generated_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:was_generated_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( linkml:Float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty heritageGraph:confidence_score ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_attributed_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:generated_at_time ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:confidence_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assertion_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:asserts_proposition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:supersedes_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:data_quality_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:data_quality_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Assertion ;
            owl:onProperty heritageGraph:supersedes_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:data_quality_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_derived_from ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:asserts_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:assertion_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:assertion_content ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:generated_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Datetime ;
            owl:onProperty heritageGraph:generated_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:was_derived_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:reconciliation_status ],
        heritageGraph:Entity ;
    skos:closeMatch schema1:Claim ;
    skos:definition "A provenance-bearing belief or claim about a heritage entity or event. The assertion is represented as CRMinf I2 Belief and as a prov:Entity, allowing source, attribution, generation time, revision, confidence, and reconciliation status to be recorded explicitly." ;
    skos:exactMatch crminf:I2_Belief ;
    skos:inScheme heritageGraph:schema ;
    skos:relatedMatch prov:Entity ;
    heritageGraph:crminf_pattern "I2_Belief -J4_that-> I4_Proposition_Set; evidence via I5_Inference_Making (J1_used_as_premise / J2_concluded_that); expert re-check via I7_Belief_Adoption" .

heritageGraph:ExistenceStatus a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( heritageGraph:Extant heritageGraph:PartiallyExtant heritageGraph:Destroyed heritageGraph:Lost heritageGraph:Hypothetical heritageGraph:Unknown ) ;
    linkml:permissible_values heritageGraph:Destroyed,
        heritageGraph:Extant,
        heritageGraph:Hypothetical,
        heritageGraph:Lost,
        heritageGraph:PartiallyExtant,
        heritageGraph:Unknown .

heritageGraph:has_assertion a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_assertion" ;
    rdfs:range heritageGraph:Assertion ;
    owl:inverseOf heritageGraph:asserts_about ;
    skos:definition "Provenance-bearing assertion made about this entity or event." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:id a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "id" ;
    rdfs:range linkml:Uriorcurie ;
    skos:definition "Globally unique URI identifier" ;
    skos:exactMatch schema1:identifier ;
    skos:inScheme heritageGraph:schema .

heritageGraph:CulturalEntityCategory a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( <https://w3id.org/heritagegraph/CulturalEntityCategory#monument> <https://w3id.org/heritagegraph/CulturalEntityCategory#artifact> <https://w3id.org/heritagegraph/CulturalEntityCategory#ritual> <https://w3id.org/heritagegraph/CulturalEntityCategory#festival> <https://w3id.org/heritagegraph/CulturalEntityCategory#tradition> <https://w3id.org/heritagegraph/CulturalEntityCategory#document> <https://w3id.org/heritagegraph/CulturalEntityCategory#other> ) ;
    linkml:permissible_values <https://w3id.org/heritagegraph/CulturalEntityCategory#artifact>,
        <https://w3id.org/heritagegraph/CulturalEntityCategory#document>,
        <https://w3id.org/heritagegraph/CulturalEntityCategory#festival>,
        <https://w3id.org/heritagegraph/CulturalEntityCategory#monument>,
        <https://w3id.org/heritagegraph/CulturalEntityCategory#other>,
        <https://w3id.org/heritagegraph/CulturalEntityCategory#ritual>,
        <https://w3id.org/heritagegraph/CulturalEntityCategory#tradition> .

heritageGraph:Guthi a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Guthi" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:guthi_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:GuthiType ;
            owl:onProperty heritageGraph:guthi_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_membership ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performs_ritual ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:has_membership ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:holds_custody_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:holds_custody_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:guthi_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:performs_ritual ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        heritageGraph:Actor ;
    skos:broadMatch crm:E74_Group,
        prov:Organization ;
    skos:definition "Endowed trust organization unique to Nepal, managing temples, rituals, and land through hereditary or voluntary membership" ;
    skos:exactMatch heritageGraph:Guthi ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Activity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Activity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:started_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Entity ;
            owl:onProperty heritageGraph:used ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:ended_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Agent ;
            owl:onProperty heritageGraph:was_associated_with ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:ended_at_time ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( heritageGraph:Entity heritageGraph:Activity heritageGraph:Agent ) ] ;
            owl:onProperty heritageGraph:was_influenced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:generated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_associated_with ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Datetime ;
            owl:onProperty heritageGraph:ended_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Entity ;
            owl:onProperty heritageGraph:generated ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Activity ;
            owl:onProperty heritageGraph:was_informed_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_informed_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:started_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Datetime ;
            owl:onProperty heritageGraph:started_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_influenced_by ] ;
    skos:definition "Direct LinkML representation of prov:Activity. Applied to events and processes that use, transform, generate, document, assess, or verify entities." ;
    skos:exactMatch prov:Activity ;
    skos:inScheme heritageGraph:schema .

heritageGraph:GuthiType a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( heritageGraph:SiGuthi heritageGraph:JatraGuthi heritageGraph:PujaGuthi heritageGraph:TempleGuthi heritageGraph:NashaGuthi heritageGraph:SanaGuthi heritageGraph:SanGuthi heritageGraph:RajGuthi ) ;
    linkml:permissible_values heritageGraph:JatraGuthi,
        heritageGraph:NashaGuthi,
        heritageGraph:PujaGuthi,
        heritageGraph:RajGuthi,
        heritageGraph:SanGuthi,
        heritageGraph:SanaGuthi,
        heritageGraph:SiGuthi,
        heritageGraph:TempleGuthi .

heritageGraph:Person a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:carried_out_activity ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
