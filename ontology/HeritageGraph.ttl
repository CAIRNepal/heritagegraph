            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:Entity ;
    skos:definition "Method or craft process used in production or ritual" ;
    skos:exactMatch crm:E29_Design_or_Procedure ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Temple a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Temple" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Enshrinement ;
            owl:onProperty heritageGraph:enshrines_deity_through_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStyle ;
            owl:onProperty heritageGraph:has_architectural_style ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_architectural_style ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enshrines_deity_through_event ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_architectural_style ],
        heritageGraph:ReligiousStructure ;
    skos:altLabel "Mandir" ;
    skos:broadMatch dbo:ReligiousBuilding ;
    skos:closeMatch schema1:HinduTemple,
        schema1:PlaceOfWorship ;
    skos:definition "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion." ;
    skos:exactMatch dbo:Temple,
        aat:300007595,
        wikidata:Q44539,
        heritageGraph:Temple ;
    skos:inScheme heritageGraph:schema .

heritageGraph:TransferOfCustody a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "TransferOfCustody" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:transferred_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty heritageGraph:transferred_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:transferred_to_guthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:transferred_from_actor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:transferred_to_actor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:transferred_object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:transferred_from_actor ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:transferred_to_guthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:transferred_to_guthi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:transferred_to_actor ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:transferred_to_actor ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:transferred_from_actor ],
        heritageGraph:Activity ;
    skos:definition "Event of transferring responsibility for temple maintenance, ritual performance, or artifact stewardship" ;
    skos:exactMatch crm:E10_Transfer_of_Custody ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:WaterStructure a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "WaterStructure" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Engineered water supply systems with ritual and civic significance" ;
    skos:exactMatch heritageGraph:WaterStructure ;
    skos:inScheme heritageGraph:schema .

heritageGraph:asserted_property a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asserted_property" ;
    rdfs:range linkml:String ;
    skos:definition "Property or attribute name (e.g., 'existence_status', 'hypothesized_location', 'construction_date')" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:asserted_value a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asserted_value" ;
    rdfs:range linkml:String ;
    skos:definition "The value claimed for this property (e.g., 'Lost', 'Handigaun', '598 CE')" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:asserts_about_entity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asserts_about_entity" ;
    rdfs:range heritageGraph:AssertableEntity ;
    skos:broadMatch crm:P140_assigned_attribute_to ;
    skos:definition "Entity that is the subject of this assertion" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:asserts_about_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "asserts_about_event" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:broadMatch crm:P141_assigned ;
    skos:definition "Event that is the subject of this assertion" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assessed_condition_state a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assessed_condition_state" ;
    rdfs:range heritageGraph:ConditionState ;
    skos:definition "Condition state identified by the assessment" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assessed_object a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assessed_object" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Object assessed for condition" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assesses_candidate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assesses_candidate" ;
    rdfs:range heritageGraph:Person ;
    skos:definition "Candidate being assessed." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assigned_to_deity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assigned_to_deity" ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "The deity instance that is the subject of the syncretic claim." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assumes_role a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "assumes_role" ;
    rdfs:range heritageGraph:KumariRole ;
    skos:definition "KumariRole held during this tenure." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:birth_timespan a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "birth_timespan" ;
    rdfs:range heritageGraph:TimeSpan ;
    rdfs:subPropertyOf heritageGraph:has_timespan ;
    skos:definition "Person's birth timespan" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:calendar_system a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "calendar_system" ;
    rdfs:range heritageGraph:CalendarSystem ;
    skos:definition "Calendar system used for date representation" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:carried_out_activity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "carried_out_activity" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Activities performed by this actor" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:category a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "category" ;
    rdfs:range heritageGraph:CulturalEntityCategory ;
    skos:definition "Domain category for a cultural entity contribution" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:crminf_conclusion a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "crminf_conclusion" ;
    rdfs:range linkml:String ;
    skos:definition "Optional CRMinf conclusion label (confirmed, refuted, uncertain)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:curator a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "curator" ;
    skos:definition "Person or organization curating the dataset." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:custodian_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "custodian_type" ;
    rdfs:range linkml:String ;
    skos:definition "Type of custodian (government, academic, community), free text" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:datacite_identifier a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "datacite_identifier" ;
    rdfs:range linkml:String ;
    skos:definition "Persistent identifier for the source (DOI, archive ID, catalog number)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:datacite_identifier_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "datacite_identifier_type" ;
    rdfs:range linkml:String ;
    skos:definition "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)" ;
