heritageGraph:route_description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "route_description" ;
    rdfs:range linkml:String ;
    skos:definition "Text description of the procession route" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:schema_version a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "schema_version" ;
    skos:definition "HeritageGraph schema version the dataset conforms to." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:source_citation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "source_citation" ;
    rdfs:range linkml:String ;
    rdfs:subPropertyOf heritageGraph:note ;
