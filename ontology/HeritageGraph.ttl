            owl:onProperty heritageGraph:place_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:wktLiteral ;
            owl:onProperty heritageGraph:place_coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:Entity ;
    skos:definition "Defined geographic location where events occur and structures exist" ;
    skos:exactMatch crm:E53_Place ;
    skos:inScheme heritageGraph:schema .

