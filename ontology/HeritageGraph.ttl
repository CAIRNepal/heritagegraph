            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_enshrined_through_event ],
        heritageGraph:Entity ;
    skos:broadMatch crm:E28_Conceptual_Object ;
    skos:definition "Divine conceptual entity in Hindu, Buddhist, or syncretic traditions. Distinct from physical representations (Murti) and ritual presences." ;
    skos:exactMatch dbo:Deity,
        aat:300343850,
        wikidata:Q178885,
        heritageGraph:Deity ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DocumentationActivity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DocumentationActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:used_method ],
        [ a owl:Restriction ;
