        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:assigned_equivalent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:assigned_to_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:assigned_equivalent ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:SyncreticType ;
            owl:onProperty heritageGraph:syncretic_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:syncretic_type ],
        heritageGraph:Activity ;
    skos:broadMatch crm:E13_Attribute_Assignment ;
    skos:definition "Formalizes the syncretic equivalence between divine entities across different theological frameworks. Following CIDOC CRM E13, it treats syncretism as a propositional claim with associated epistemic authority and provenance." ;
    skos:exactMatch heritageGraph:SyncreticRelationship ;
    skos:inScheme heritageGraph:schema .

