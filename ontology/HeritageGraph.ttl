    skos:inScheme heritageGraph:schema .

heritageGraph:proposition_subject a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposition_subject" ;
    rdfs:range heritageGraph:AssertionSubject ;
    skos:definition "Entity the proposition is about (plays the role of rdf:subject)." ;
