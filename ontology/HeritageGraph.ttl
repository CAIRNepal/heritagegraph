        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:institutional_affiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
