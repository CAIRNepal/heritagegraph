heritageGraph:description a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "description" ;
    rdfs:range linkml:String ;
    skos:definition "Long-form narrative description" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:destruction_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "destruction_event" ;
    rdfs:range heritageGraph:DestructionEvent ;
    skos:definition "Event that destroyed this structure (if known)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:documents a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "documents" ;
    rdfs:range heritageGraph:AssertionSubject ;
    owl:inverseOf heritageGraph:was_documented_by ;
    skos:definition "Pre-existing heritage entity or event recorded by this documentation activity (inverse of was_documented_by)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:end_place a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "end_place" ;
    rdfs:range heritageGraph:Place ;
    skos:definition "Ending location of movement ritual" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ended_at_time a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "ended_at_time" ;
    rdfs:range linkml:Datetime ;
    skos:definition "Time at which this activity ended." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrines_deity_through_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "enshrines_deity_through_event" ;
    rdfs:range heritageGraph:Enshrinement ;
    owl:inverseOf heritageGraph:enshrined_in_structure ;
    skos:definition "Enshrinement event that installed deity in temple" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enthroned_person a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "enthroned_person" ;
    rdfs:range heritageGraph:Person ;
    skos:definition "Girl enthroned as Kumari by this enthronement event." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enthroned_through a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "enthroned_through" ;
    rdfs:range heritageGraph:KumariEnthronementEvent ;
    skos:definition "Enthronement event that activated this tenure." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:epoch_date_gregorian a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "epoch_date_gregorian" ;
    rdfs:range linkml:String ;
    skos:definition "The start date of this calendar era in Gregorian ISO format." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:generated_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "generated_date" ;
    skos:definition "Date the dataset serialization was generated (ISO 8601)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:guthi_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "guthi_type" ;
    rdfs:range heritageGraph:GuthiType ;
    rdfs:subPropertyOf heritageGraph:has_type ;
    skos:definition "Type of Guthi (Si, Jatra, Temple)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:has_condition_type a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_condition_type" ;
    rdfs:range heritageGraph:ConditionType ;
    rdfs:subPropertyOf heritageGraph:has_type ;
    skos:definition "Categorization of the condition state" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:has_retirement_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_retirement_event" ;
    rdfs:range heritageGraph:LivingGoddessRetirement ;
    owl:inverseOf heritageGraph:ended_tenure_of ;
    skos:definition "Retirement event that ended this Living Goddess tenure" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:institutional_affiliation a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "institutional_affiliation" ;
    rdfs:range linkml:String ;
    skos:definition "Institutional affiliation (e.g., Tribhuvan University, Nepal Heritage Society)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:is_about_deity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "is_about_deity" ;
    rdfs:range heritageGraph:Deity ;
    rdfs:subPropertyOf heritageGraph:depicts_deity ;
    skos:definition "Deity represented and ritually associated with the Murti" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:is_component_of a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "is_component_of" ;
    rdfs:range heritageGraph:ArchitecturalStructure ;
    skos:definition "Larger structure that this element is part of" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:is_enshrined_through_event a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "is_enshrined_through_event" ;
    rdfs:range heritageGraph:Enshrinement ;
    owl:inverseOf heritageGraph:enshrined_deity ;
    skos:definition "Events where this deity was enshrined" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:is_part_of_festival a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "is_part_of_festival" ;
    rdfs:range heritageGraph:Festival ;
    skos:definition "Larger festival this ritual is part of" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:justification_note a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "justification_note" ;
    rdfs:range linkml:String ;
    skos:definition "CRMinf justification or reasoning summary for this belief" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:last_known_existence_date a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "last_known_existence_date" ;
    rdfs:range linkml:Date ;
    skos:definition "Latest date when this structure is documented as existing (ISO 8601)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:license a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "license" ;
    skos:definition "License under which the dataset is released." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:lunar_date_tithi a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "lunar_date_tithi" ;
    rdfs:range linkml:String ;
    skos:definition "Lunar day (Tithi) for ritual timing" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:makes_deity_present a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "makes_deity_present" ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Deity made present through consecration" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:metadata a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "metadata" ;
    skos:definition "Dataset metadata" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:occurred_in_presence_of a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "occurred_in_presence_of" ;
    rdfs:range heritageGraph:Entity ;
    skos:definition "Generic CRM presence relation (P12): entity present at an event. Canonical holder of the CRM predicate; use the specific presence slots in data." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:occurs_after a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "occurs_after" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Points to the prerequisite ritual." ;
