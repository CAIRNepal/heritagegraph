heritageGraph:produced_object a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "produced_object" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Object produced by this production event" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:proposition_object_entity a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposition_object_entity" ;
    rdfs:range heritageGraph:AssertionSubject ;
    skos:definition "Object of the proposition when it is a heritage entity (plays the role of rdf:object)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:proposition_object_literal a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposition_object_literal" ;
    rdfs:range linkml:String ;
    skos:definition "Object of the proposition when it is a literal value (e.g. a date)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:proposition_predicate a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "proposition_predicate" ;
