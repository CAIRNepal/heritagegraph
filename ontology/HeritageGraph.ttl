    skos:definition "Intentional ritual activity that activates sacred space, invokes deities, and binds social groups" ;
    skos:exactMatch heritageGraph:RitualEvent ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:was_documented_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_documented_by" ;
    rdfs:range heritageGraph:DocumentationActivity ;
    rdfs:subPropertyOf heritageGraph:was_influenced_by ;
    owl:inverseOf heritageGraph:documents ;
    skos:definition "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment "prov:wasInfluencedBy" .

heritageGraph:took_place_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "took_place_at" ;
    rdfs:range heritageGraph:Place ;
    skos:definition "Place where the event occurred" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Entity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_derived_from ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_generated_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Uriorcurie ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:Datetime ;
            owl:onProperty heritageGraph:generated_at_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_attributed_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_influenced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Entity ;
            owl:onProperty heritageGraph:was_derived_from ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:generated_at_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( heritageGraph:Entity heritageGraph:Activity heritageGraph:Agent ) ] ;
            owl:onProperty heritageGraph:was_influenced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Agent ;
            owl:onProperty heritageGraph:was_attributed_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Activity ;
            owl:onProperty heritageGraph:was_generated_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:was_generated_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:generated_at_time ] ;
    skos:definition "Direct LinkML representation of prov:Entity. Applied to physical, digital, conceptual, and assertion-bearing things that participate in provenance relations. PROVENANCE SCOPE (design decision): for classes whose instances are real-world referents (structures, deities, places, actors), the provenance slots (was_derived_from, was_attributed_to, was_generated_by, generated_at_time) describe the DATA RECORD about the referent, not the referent itself -- a stupa is not generated by the survey that records it. Referent-level history is modelled through events (Production, DestructionEvent, etc.). RDF deployments SHOULD carry record-level provenance in named graphs or on InformationObject/Assertion nodes." ;
    skos:exactMatch prov:Entity ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:provenance_scope "record" .

heritageGraph:Actor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Actor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom linkml:String ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        heritageGraph:Agent ;
    skos:definition "General actor (person or group) responsible for events" ;
    skos:exactMatch crm:E39_Actor ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RitualType a owl:Class,
        linkml:EnumDefinition ;
    owl:unionOf ( heritageGraph:NityaPuja heritageGraph:NaimittikaPuja heritageGraph:KamyaPuja heritageGraph:Abhisheka heritageGraph:Homa heritageGraph:Bhajan heritageGraph:Yagna heritageGraph:Vrata heritageGraph:Jatra heritageGraph:ChariotProcession heritageGraph:MaskedPerformance heritageGraph:RitualConsecration heritageGraph:ProcessionRitual heritageGraph:InstallationRitual heritageGraph:DeinstallationRitual heritageGraph:ReturningRitual heritageGraph:Circumambulation heritageGraph:RelicTour heritageGraph:ProcessionalMovement ) ;
    linkml:permissible_values heritageGraph:Abhisheka,
        heritageGraph:Bhajan,
        heritageGraph:ChariotProcession,
        heritageGraph:Circumambulation,
        heritageGraph:DeinstallationRitual,
        heritageGraph:Homa,
        heritageGraph:InstallationRitual,
        heritageGraph:Jatra,
        heritageGraph:KamyaPuja,
        heritageGraph:MaskedPerformance,
        heritageGraph:NaimittikaPuja,
        heritageGraph:NityaPuja,
        heritageGraph:ProcessionRitual,
        heritageGraph:ProcessionalMovement,
        heritageGraph:RelicTour,
        heritageGraph:ReturningRitual,
        heritageGraph:RitualConsecration,
        heritageGraph:Vrata,
        heritageGraph:Yagna .

heritageGraph:has_timespan a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_timespan" ;
    rdfs:range heritageGraph:TimeSpan ;
    skos:definition "Links event to its temporal extent" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:note a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "note" ;
    rdfs:range linkml:String ;
    skos:definition "Free-text note (description, reason, verification notes)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:name a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    rdfs:range linkml:String ;
    skos:definition "Primary name or label" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:schema a owl:Ontology ;
    rdfs:label "HeritageGraph" ;
    dct:bibliographicCitation "CAIR-Nepal (2026). HeritageGraph Ontology (0.1.0). https://w3id.org/heritagegraph/ontology" ;
    dct:created "2025-11-23" ;
    dct:creator "CAIR-Nepal" ;
    dct:license "CC-BY-4.0",
        "https://creativecommons.org/licenses/by/4.0/" ;
    dct:modified "2026-07-22" ;
    dct:publisher "CAIR-Nepal" ;
    dct:source "https://github.com/CAIRNepal/heritagegraphontology" ;
    bibo:status "Pre-release specification draft" ;
    pav:version "1.1.0" ;
    vann:preferredNamespacePrefix "heritageGraph" ;
    vann:preferredNamespaceUri "https://w3id.org/heritagegraph/" ;
    owl:ontologyIRI "https://w3id.org/heritagegraph/ontology" ;
    owl:versionIRI "https://w3id.org/heritagegraph/ontology/0.1.0" ;
    owl:versionInfo "0.1.0" ;
    skos:definition "An event-centric LinkML schema for representing Nepal cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges. Enables provenance tracking, ritual-spatial-temporal reasoning, and multi-calendar date representation. Merges the upstream HeritageGraph 0.1.0 ontology draft into the deployed platform schema." .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty heritageGraph:has_current_location ;
            owl:someValuesFrom owl:Thing ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty heritageGraph:existence_status ;
                owl:someValuesFrom linkml:String ] heritageGraph:ArchitecturalStructure ) .

