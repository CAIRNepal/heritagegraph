# Frontend URLs
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET=your-nextauth-secret-change-this

# ----------------------------------------------------------------
# Google OAuth (REQUIRED — primary auth provider)
# Get from https://console.cloud.google.com/apis/credentials
# Callback URL: http://localhost:3000/api/auth/callback/google
# ----------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public API URL (browser fetches). Use ONE of:
#   Docker + Traefik:  http://backend.localhost
#   Local runserver:   http://localhost:8000   (see `make frontend`)
NEXT_PUBLIC_API_URL=http://backend.localhost

# Server-side only (NextAuth → Django). Defaults to NEXT_PUBLIC_API_URL, then:
#   development → http://localhost:8000
#   production (Docker) → http://backend:8000
# INTERNAL_BACKEND_URL=http://localhost:8000

# Heritage Atlas (Cesium): optional; show Atlas error-boundary detail in production for operators / support.
# NEXT_PUBLIC_ATLAS_SHOW_ERROR_DETAIL=true

# Optional: show derived semantic graph + JSON-LD preview on contribute / ontology forms (matches server RDF subject URIs).
# NEXT_PUBLIC_SHOW_FORM_GRAPH=true
# NEXT_PUBLIC_RDF_RESOURCE_BASE_URI=https://w3id.org/heritagegraph/resource
