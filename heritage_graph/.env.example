# ----------------------------------------------------------------
# Infrastructure requirements (backend)
# ----------------------------------------------------------------
# PostGIS / Geo (optional): `point` columns are plain text unless you enable GIS end-to-end.
#   1. Image: GDAL/GEOS/proj (see Dockerfile.backend) + Postgres CREATE EXTENSION postgis;
#   2. Set HERITAGEGRAPH_ENABLE_POSTGIS=1 in production (loads django.contrib.gis).
#   3. DATABASES ENGINE: django.contrib.gis.db.backends.postgis + migrations to geometry.
# Until then leave HERITAGEGRAPH_ENABLE_POSTGIS unset or 0 — lean images start without GDAL.
# ----------------------------------------------------------------

# Optional: LinkML extension file merged into the effective ontology registry after
# moderator publish (see SchemaExtensionProposal). Path must be readable/writable by
# the app user in environments that use schema extension approval.
# HERITAGEGRAPH_SCHEMA_EXTENSION_PATH=/path/to/extension.yaml

# Google OAuth — backend needs the client ID to verify Google ID tokens
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth — backend needs these to verify GitHub access tokens
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Anthropic (OCR vision rescue only; see root `.env.example` for the same key)
ANTHROPIC_API_KEY=your-anthropic-api-key

# In-app assistant — OpenRouter (see root `.env.example` for model slugs and tier env)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL_FAST=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL_STANDARD=anthropic/claude-3-5-haiku-20241022
OPENROUTER_MODEL_PREMIUM=anthropic/claude-3-5-sonnet-20241022
