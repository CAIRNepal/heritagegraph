# Base image
FROM ubuntu:22.04

# Set environment variable to skip prompts during apt install
ARG DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    git \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy project files
COPY . /app

# Install Python requirements
RUN pip3 install --no-cache-dir -r heritage_graph/requirements/requirements.txt

# Run Django database migrations
RUN python3 manage.py makemigrations --noinput
RUN python3 manage.py migrate --noinput

# Expose the port
EXPOSE 8000

# Set default command to run Django development server
CMD ["python3", "manage.py", "runserver", "0.0.0.0:8000"]
