# ================================================================
# HeritageGraph Environment Configuration
# ================================================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to version control
# ================================================================

# ================================================================
# ENVIRONMENT MODE
# ================================================================
# Set to 'development' or 'production'
ENVIRONMENT=development
DEBUG=False

# ================================================================
# DJANGO CONFIGURATION
# ================================================================
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_SETTINGS_MODULE=heritage_graph.settings.production
ALLOWED_HOSTS=localhost,127.0.0.1,backend.localhost,heritagegraph.xyz,www.heritagegraph.xyz,api.heritagegraph.xyz

# Django Superuser (for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme123!

# ================================================================
# DATABASE CONFIGURATION
# ================================================================
# PostgreSQL Database for Django
DB_ENGINE=django.db.backends.postgresql
DB_NAME=heritage_db
DB_USER=heritage_user
DB_PASSWORD=your-db-password-change-this
DB_HOST=postgres
DB_PORT=5432

# GeoDjango / PostGIS: set to 1 only when the backend image has GDAL/GEOS/proj, Postgres
# has PostGIS, and DATABASES ENGINE uses the PostGIS backend. Default is off (CharField point).
# HERITAGEGRAPH_ENABLE_POSTGIS=0

# PostgreSQL superuser (for init scripts)
POSTGRES_DB=heritage_db
POSTGRES_USER=heritage_user
POSTGRES_PASSWORD=your-db-password-change-this

# ================================================================
# GOOGLE OAUTH CONFIGURATION
# ================================================================
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ================================================================
# GITHUB OAUTH CONFIGURATION
# ================================================================
# Get these from https://github.com/settings/developers → OAuth Apps
GITHUB_ID=your-github-client-id
GITHUB_SECRET=your-github-client-secret
# Also set on the backend so Django can identify GitHub tokens
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ================================================================
# FRONTEND CONFIGURATION (Next.js)
# ================================================================
# Development: http://backend.localhost  |  Production: https://api.heritagegraph.xyz
NEXT_PUBLIC_API_URL=http://backend.localhost
# Origin of the main Next.js app — used by heritage_graph_landing (Docker: frontend.localhost)
NEXT_PUBLIC_APP_URL=http://frontend.localhost

# ================================================================
# BACKEND CONFIGURATION
# ================================================================
# CORS Settings
# Development: http://localhost:3000,http://frontend.localhost
# Production:  https://heritagegraph.xyz,https://www.heritagegraph.xyz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend.localhost

# API Configuration
API_TITLE=HeritageGraph API
API_VERSION=v1
API_DESCRIPTION=Digital Heritage Graph API

# ================================================================
# TRAEFIK CONFIGURATION
# ================================================================
# Dashboard access control
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=your-hashed-password-or-password
# Generate with: htpasswd -n admin
# Or use: openssl passwd -apr1

# SSL/TLS Configuration (for production with Let's Encrypt)
TRAEFIK_ACME_EMAIL=admin@heritagegraph.xyz
TRAEFIK_ACME_STORAGE=/etc/traefik/acme/acme.json
ACME_ENABLED=false
# Set to true and configure Let's Encrypt email for production

# ================================================================
# LOGGING
# ================================================================
LOG_LEVEL=INFO

# ================================================================
# CELERY & ASYNC TASK QUEUE CONFIGURATION
# ================================================================
# Redis broker for Celery task queue
# Development: redis://localhost:6379  |  Production: add auth, use external Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ================================================================
# OCR & DOCUMENT PROCESSING CONFIGURATION
# ================================================================
# Enable/disable OCR processing pipeline
OCR_ENABLED=true

# Tesseract installation path (if not in system PATH)
# Leave blank to auto-detect (works if installed via apt/brew)
TESSERACT_PATH=/usr/bin/tesseract

# Claude Vision API key for OCR rescue of difficult inscriptions
# Required only if Claude Vision rescue is enabled
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# In-app chat assistant (OpenRouter — not Anthropic direct; tiered models for cost)
# Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: app listing on OpenRouter (https://openrouter.ai/docs#request-headers)
# OPENROUTER_HTTP_REFERER=https://heritagegraph.org
# OPENROUTER_X_TITLE=HeritageGraph
# Default OpenAI-compatible base (override only if needed)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# One OpenRouter model slug per cost tier (see apps/assistant/services/routing.py)
OPENROUTER_MODEL_FAST=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MODEL_STANDARD=anthropic/claude-3-5-haiku-20241022
OPENROUTER_MODEL_PREMIUM=anthropic/claude-3-5-sonnet-20241022
# Optional: tune server-side tier selection (length, thread depth, source count)
# ASSISTANT_TIER_PREMIUM_MIN_USER_CHARS=600
# ASSISTANT_TIER_PREMIUM_MIN_TURNS=9
# ASSISTANT_TIER_PREMIUM_MIN_SOURCES=5
# ASSISTANT_TIER_FAST_MAX_USER_CHARS=100
# ASSISTANT_TIER_FAST_MAX_USER_MESSAGES=2
# ASSISTANT_TIER_FAST_MAX_SOURCES=1
# ASSISTANT_MAX_OUTPUT_TOKENS=1200
# ASSISTANT_TEMPERATURE=0.25

# OCR configuration
OCR_CONFIDENCE_THRESHOLD=0.6
OCR_MAX_PAGES_PER_DOCUMENT=100
OCR_MAX_FILE_BYTES=26214400
# Cost control: max 1 Vision call per document
OCR_CLAUDE_VISION_MAX_CALLS_PER_DOCUMENT=1


# ================================================================
# EMAIL CONFIGURATION (optional)
# ================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@heritagegraph.xyz

# ================================================================
# EXTERNAL SERVICES (if applicable)
# ================================================================
# Oxigraph RDF Database (if used)
OXIGRAPH_URL=http://oxigraph:7878

# Apache Jena Fuseki standalone stack: see FUSEKI.md and docker-compose.fuseki.yml
# Published port (default 3030)
# FUSEKI_PORT=3030
# First empty dataset name at container start (default in compose: heritage)
# FUSEKI_DATASET_1=heritage
# JVM heap, e.g. -Xmx2g (optional)
# FUSEKI_JVM_ARGS=-Xmx1200m
# Fuseki UI: user admin; overrides compose default password if set (see FUSEKI.md)
# FUSEKI_ADMIN_PASSWORD=

# ================================================================
# ONTOLOGY / SCHEMA REGISTRY (YAML → API + UI, see specs/004-yaml-driven-schema)
# ================================================================
# Path to the authoritative LinkML file (repo default: ontology/HeritageGraph.yaml)
HERITAGEGRAPH_SCHEMA_PATH=ontology/HeritageGraph.yaml
# Optional per-tenant extension YAML (empty = none)
HERITAGEGRAPH_SCHEMA_EXTENSION_PATH=
# Cache-Control max-age (seconds) for GET /api/v1/cidoc/schema/registry/
HERITAGEGRAPH_SCHEMA_CACHE_TTL=60
# If true, prefer live YAML for the registry API instead of the DB snapshot (useful in staging)
HERITAGEGRAPH_SCHEMA_REGISTRY_PREFER_FRESH=false
# RDF sidecar (optional; P3) — leave empty until triplestore is wired
# Oxigraph HTTP server: typically http://host:7878/sparql
# Fuseki 2 (per-dataset query service): http://localhost:3030/<dataset>/query
# Example when Fuseki compose uses dataset "heritage" and Django runs on host:
# RDF_ENDPOINT_URL=http://localhost:3030/heritage/query
# RDF_SYNC_ENABLED may need a separate update endpoint for Fuseki (/.../update); see FUSEKI.md
RDF_ENDPOINT_URL=
RDF_SYNC_ENABLED=false

# ================================================================
# DOCKER & DEPLOYMENT
# ================================================================
# Docker registry for pushing images
DOCKER_REGISTRY=your-registry
DOCKER_USERNAME=your-username
DOCKER_PASSWORD=your-password

# Deployment URLs
# Domain used by Traefik for routing (production)
DOMAIN=heritagegraph.xyz
PRODUCTION_URL=https://heritagegraph.xyz
