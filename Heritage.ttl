    skos:definition "Temporal extent of an event or period" ;
    skos:exactMatch crm:E52_Time-Span ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Place a owl:Class ;
    owl:disjointWith heritageGraph:CalendarSystem ;
    owl:disjointWith heritageGraph:CasteGroup ;
    owl:disjointWith heritageGraph:Deity ;
    owl:disjointWith heritageGraph:Guthi ;
    owl:disjointWith heritageGraph:HumanMadeObject ;
    owl:disjointWith heritageGraph:Person ;
    owl:disjointWith heritageGraph:TimeSpan ;
    rdfs:label "Place" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:place_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:contains_structure ],
        [ a owl:Restriction ;
