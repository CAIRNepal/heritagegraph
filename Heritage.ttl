@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix heritageGraph: <https://w3id.org/heritagegraph/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix wikidata: <http://www.wikidata.org/entity/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<HeritageGraph.owl.ttl> a owl:Ontology ;
    rdfs:label "HeritageGraph" ;
    dct:creator "Cair Nepal" ;
    dct:license "CC-BY-4.0",
        "https://creativecommons.org/licenses/by/4.0/" ;
    dct:publisher "Cair Nepal" ;
    pav:version "1.0.0" ;
    owl:imports "http://www.cidoc-crm.org/cidoc-crm/ http://www.w3.org/ns/prov#" ;
    owl:ontologyIRI "https://w3id.org/heritagegraph/ontology" ;
    owl:versionIRI "https://w3id.org/heritagegraph/ontology/1.0.0" ;
    skos:definition "An event-centric LinkML schema for representing Nepal cultural heritage information, fully aligned with CIDOC-CRM v7.2.1 and PROV-O. Enables provenance tracking, ritual-spatial-temporal reasoning, and multi-calendar date representation. DL expressivity: ALCIQ(D)." .

heritageGraph:Container a owl:Class ;
    rdfs:label "Container" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataCustodian ;
            owl:onProperty heritageGraph:data_custodians ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:HeritageAssertion ;
            owl:onProperty heritageGraph:provenance_assertions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Enshrinement ;
            owl:onProperty heritageGraph:enshrinement_events ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enshrinement_events ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:SyncreticRelationship ;
            owl:onProperty heritageGraph:syncretic_relationships ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:guthis ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:persons ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:consecration_events ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:places ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentation_activities ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Festival ;
            owl:onProperty heritageGraph:festivals ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:production_events ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:physical_heritage_things ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TransferOfCustody ;
            owl:onProperty heritageGraph:custody_events ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:CasteGroup ;
            owl:onProperty heritageGraph:caste_groups ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:data_sources ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:religious_traditions ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentation_activities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:data_sources ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:deities ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:persons ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:deities ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Material ;
            owl:onProperty heritageGraph:materials ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:caste_groups ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:calendar_systems ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_architectural_style ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:festivals ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalElement ;
            owl:onProperty heritageGraph:architectural_elements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:architectural_elements ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:materials ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:InformationObject ;
            owl:onProperty heritageGraph:information_objects ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:data_custodians ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty heritageGraph:physical_heritage_things ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Production ;
            owl:onProperty heritageGraph:production_events ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:guthis ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:syncretic_relationships ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:information_objects ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E55_Type ;
            owl:onProperty heritageGraph:has_architectural_style ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:ritual_events ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:custody_events ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:provenance_assertions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Metadata ;
            owl:onProperty heritageGraph:metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:CalendarSystem ;
            owl:onProperty heritageGraph:calendar_systems ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Consecration ;
            owl:onProperty heritageGraph:consecration_events ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:religious_traditions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:places ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:ritual_events ] ;
    skos:definition "Root container for cultural heritage data instances" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:FieldSurveyActivity a owl:Class ;
    owl:disjointWith heritageGraph:OralHistoryInterview ;
    owl:disjointWith heritageGraph:Verification ;
    rdfs:label "FieldSurveyActivity" ;
    rdfs:subClassOf heritageGraph:DocumentationActivity ;
    skos:definition "The activity of measuring, photographing, or assessing a site in person." ;
    skos:exactMatch crmsci:S4_Observation ;
    skos:inScheme <HeritageGraph> .

heritageGraph:FieldSurveyDataset a owl:Class ;
    owl:disjointWith heritageGraph:ArchivalRecord ;
    owl:disjointWith heritageGraph:OralHistoryRecording ;
    rdfs:label "FieldSurveyDataset" ;
    rdfs:subClassOf heritageGraph:DataSource ;
    skos:definition "The structured data or report resulting from a field survey." ;
    skos:exactMatch crm:E31_Document ;
    skos:inScheme <HeritageGraph> .

heritageGraph:OralHistoryInterview a owl:Class ;
    owl:disjointWith heritageGraph:FieldSurveyActivity ;
    owl:disjointWith heritageGraph:Verification ;
    rdfs:label "OralHistoryInterview" ;
    rdfs:subClassOf heritageGraph:DocumentationActivity ;
    skos:definition "The interaction event between a researcher and a knowledge holder." ;
    skos:exactMatch crm:E65_Creation ;
    skos:inScheme <HeritageGraph> .

heritageGraph:OralHistoryRecording a owl:Class ;
    owl:disjointWith heritageGraph:ArchivalRecord ;
    owl:disjointWith heritageGraph:FieldSurveyDataset ;
    rdfs:label "OralHistoryRecording" ;
    rdfs:subClassOf heritageGraph:DataSource ;
    skos:definition "The recording or transcript of an oral history interview." ;
    skos:exactMatch crm:E33_Linguistic_Object ;
    skos:inScheme <HeritageGraph> .

heritageGraph:ArchivalRecord a owl:Class ;
    owl:disjointWith heritageGraph:FieldSurveyDataset ;
    owl:disjointWith heritageGraph:OralHistoryRecording ;
    rdfs:label "ArchivalRecord" ;
    rdfs:subClassOf heritageGraph:DataSource ;
    skos:broadMatch crm:E31_Document ;
    skos:definition "Government or institutional administrative record" ;
    skos:exactMatch heritageGraph:ArchivalRecord,
        rico:Record ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Chaitya a owl:Class ;
    owl:disjointWith heritageGraph:Stupa ;
    rdfs:label "Chaitya" ;
    rdfs:subClassOf heritageGraph:BuddhistMonument ;
    skos:definition "Buddhist votive shrine or prayer hall" ;
    skos:exactMatch heritageGraph:Chaitya ;
    skos:inScheme <HeritageGraph> .

heritageGraph:ChariotFestival a owl:Class ;
    owl:disjointWith heritageGraph:MaskedDance ;
    rdfs:label "ChariotFestival" ;
    rdfs:subClassOf heritageGraph:Festival ;
    skos:definition "Festival involving ceremonial chariot procession (e.g., Rato Machhindranath Jatra)" ;
    skos:exactMatch heritageGraph:ChariotFestival ;
    skos:inScheme <HeritageGraph> .

heritageGraph:DataCustodian a owl:Class ;
    rdfs:label "DataCustodian" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:custodian_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:custodian_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:custodian_type ] ;
    skos:definition "Institution or person currently stewarding heritage data" ;
    skos:exactMatch prov:Agent ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Dharmashala a owl:Class ;
    owl:disjointWith heritageGraph:Pati ;
    owl:disjointWith heritageGraph:Sattal ;
    rdfs:label "Dharmashala" ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:definition "Pilgrim lodge operated by a Guthi organization" ;
    skos:exactMatch heritageGraph:Dharmashala ;
    skos:inScheme <HeritageGraph> .

heritageGraph:DhungeDhara a owl:Class ;
    owl:disjointWith heritageGraph:Pokhari ;
    rdfs:label "DhungeDhara" ;
    rdfs:subClassOf heritageGraph:WaterStructure ;
    skos:definition "Stone spout (hiti) with carved imagery, used for ritual bathing and daily water supply" ;
    skos:exactMatch heritageGraph:DhungeDhara ;
    skos:inScheme <HeritageGraph> .

heritageGraph:HistoricalEvent a owl:Class ;
    rdfs:label "HistoricalEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:includes_ritual_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:includes_ritual_event ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:architectural_structures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:architectural_structures ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ] ;
    skos:definition "Major event affecting heritage structures or ritual life (earthquake, epidemic, political transition, fire, flood)." ;
    skos:exactMatch crm:E5_Event ;
    skos:inScheme <HeritageGraph> .

heritageGraph:LivingGoddessSelection a owl:Class ;
    owl:disjointWith heritageGraph:LivingGoddessRetirement ;
    rdfs:label "LivingGoddessSelection" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty heritageGraph:is_critical_for_festival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_critical_for_festival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:initiated_tenure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:selected_person ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:LivingGoddessTenure ;
            owl:onProperty heritageGraph:initiated_tenure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:initiated_tenure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:selected_person ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_critical_for_festival ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:HeritageAssertion ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:selection_criteria_met ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] ;
            owl:onProperty heritageGraph:performed_by_group ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:selected_person ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performed_by_group ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:selection_criteria_met ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        heritageGraph:RitualEvent ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer." ;
    skos:exactMatch heritageGraph:LivingGoddessSelection ;
    skos:inScheme <HeritageGraph> .

heritageGraph:MaskedDance a owl:Class ;
    owl:disjointWith heritageGraph:ChariotFestival ;
    rdfs:label "MaskedDance" ;
    rdfs:subClassOf heritageGraph:Festival ;
    skos:definition "Festival featuring masked dancers embodying deities (e.g., Kartik Naach)" ;
    skos:exactMatch heritageGraph:MaskedDance ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Metadata a owl:Class ;
    rdfs:label "Metadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:dataset_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:generated_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:license ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:schema_version ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:curator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:schema_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:dataset_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:curator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:dataset_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:curator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:generated_date ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:generated_date ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:dataset_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:dataset_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:dataset_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:schema_version ] ;
    skos:definition "Dataset metadata information" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Pati a owl:Class ;
    owl:disjointWith heritageGraph:Dharmashala ;
    owl:disjointWith heritageGraph:Sattal ;
    rdfs:label "Pati" ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:definition "Open-air pavilion for resting travelers" ;
    skos:exactMatch heritageGraph:Pati ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Paubha a owl:Class ;
    owl:disjointWith heritageGraph:Murti ;
    rdfs:label "Paubha" ;
    rdfs:subClassOf heritageGraph:IconographicObject ;
    skos:broadMatch aat:300033666 ;
    skos:closeMatch wikidata:Q130993 ;
    skos:definition "Traditional Newari scroll painting (thangka) with mandala and deity iconography" ;
    skos:exactMatch heritageGraph:Paubha ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Pokhari a owl:Class ;
    owl:disjointWith heritageGraph:DhungeDhara ;
    rdfs:label "Pokhari" ;
    rdfs:subClassOf heritageGraph:WaterStructure ;
    skos:definition "Pond or tank for water storage, ritual bathing, and ecological management" ;
    skos:exactMatch heritageGraph:Pokhari ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Sattal a owl:Class ;
    owl:disjointWith heritageGraph:Dharmashala ;
    owl:disjointWith heritageGraph:Pati ;
    rdfs:label "Sattal" ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:definition "Multi-story rest house (3-5 floors) with ritual and social functions" ;
    skos:exactMatch heritageGraph:Sattal ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Stupa a owl:Class ;
    owl:disjointWith heritageGraph:Chaitya ;
    rdfs:label "Stupa" ;
    rdfs:subClassOf heritageGraph:BuddhistMonument ;
    skos:definition "Buddhist dome-shaped reliquary shrine (e.g., Boudhanath, Swayambhunath)" ;
    skos:exactMatch heritageGraph:Stupa ;
    skos:inScheme <HeritageGraph> .

heritageGraph:SyncreticRelationship a owl:Class ;
    rdfs:label "SyncreticRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:documented_in_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:syncretic_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:assigned_equivalent ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:assigned_to_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:syncretic_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:assigned_to_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:assertion_author ],
