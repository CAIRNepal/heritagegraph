heritageGraph:TimeSpan a owl:Class ;
    owl:disjointWith heritageGraph:Deity ;
    owl:disjointWith heritageGraph:HumanMadeObject ;
    owl:disjointWith heritageGraph:Person ;
    owl:disjointWith heritageGraph:Place ;
    rdfs:label "TimeSpan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:date_latest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:date_precision ],
        [ a owl:Restriction ;
