            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:place_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:contains_structure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:place_type ] ;
    skos:definition "Defined geographic location where events occur and structures exist" ;
    skos:exactMatch crm:E53_Place ;
    skos:inScheme <HeritageGraph> .

heritageGraph:RitualTypeEnum a owl:Class ;
    rdfs:label "RitualTypeEnum" ;
    owl:unionOf ( heritageGraph:NityaPuja heritageGraph:NaimittikaPuja heritageGraph:KamyaPuja heritageGraph:Abhisheka heritageGraph:Homa heritageGraph:Bhajan heritageGraph:Yagna heritageGraph:Vrata heritageGraph:Jatra heritageGraph:ChariotProcession heritageGraph:MaskedPerformance heritageGraph:RitualConsecration heritageGraph:ProcessionRitual heritageGraph:InstallationRitual heritageGraph:DeinstallationRitual heritageGraph:ReturningRitual heritageGraph:Circumambulation heritageGraph:RelicTour heritageGraph:ProcessionalMovement ) ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values heritageGraph:Abhisheka,
        heritageGraph:Bhajan,
        heritageGraph:ChariotProcession,
        heritageGraph:Circumambulation,
        heritageGraph:DeinstallationRitual,
        heritageGraph:Homa,
        heritageGraph:InstallationRitual,
        heritageGraph:Jatra,
        heritageGraph:KamyaPuja,
        heritageGraph:MaskedPerformance,
        heritageGraph:NaimittikaPuja,
        heritageGraph:NityaPuja,
        heritageGraph:ProcessionRitual,
        heritageGraph:ProcessionalMovement,
        heritageGraph:RelicTour,
        heritageGraph:ReturningRitual,
        heritageGraph:RitualConsecration,
        heritageGraph:Vrata,
        heritageGraph:Yagna .

