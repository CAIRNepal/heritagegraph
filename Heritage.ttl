heritageGraph:metadata a owl:ObjectProperty ;
    rdfs:label "metadata" ;
    skos:definition "Dataset metadata" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:occurs_after a owl:ObjectProperty ;
    rdfs:label "occurs_after" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Points to the prerequisite ritual." ;
    skos:inScheme <HeritageGraph> .

heritageGraph:occurs_before a owl:ObjectProperty ;
    rdfs:label "occurs_before" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Points to the next ritual in the canonical sequence." ;
    skos:inScheme <HeritageGraph> .

heritageGraph:place_coordinates a owl:DatatypeProperty ;
    rdfs:label "place_coordinates" ;
    rdfs:range geo:wktLiteral ;
    skos:definition "Coordinates as WKT literal" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:place_type a owl:DatatypeProperty ;
    rdfs:label "place_type" ;
    rdfs:range xsd:string ;
    skos:broadMatch crm:P2_has_type ;
    skos:definition "Type of place (city, village, region)" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:publication_timespan a owl:ObjectProperty ;
    rdfs:label "publication_timespan" ;
    rdfs:range heritageGraph:TimeSpan ;
    skos:broadMatch crm:P4_has_time-span ;
    skos:definition "When source was published" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:reconciliation_status a owl:DatatypeProperty ;
    rdfs:label "reconciliation_status" ;
    rdfs:range xsd:string ;
    skos:definition "Status of multi-source reconciliation (confirmed, conflicting, unverified)" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:recurrence_pattern a owl:DatatypeProperty ;
    rdfs:label "recurrence_pattern" ;
    rdfs:range xsd:string ;
    skos:definition "Frequency of recurring ritual (e.g., annual, monthly)" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:residence_structure a owl:ObjectProperty ;
    rdfs:label "residence_structure" ;
    rdfs:range heritageGraph:ArchitecturalStructure ;
    skos:definition "Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house)." ;
    skos:inScheme <HeritageGraph> .

heritageGraph:ritual_on_structure a owl:ObjectProperty ;
    rdfs:label "ritual_on_structure" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Ritual occurs at specific temple or monument" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:ritual_type a owl:ObjectProperty ;
    rdfs:label "ritual_type" ;
    rdfs:range heritageGraph:RitualTypeEnum ;
    skos:broadMatch crm:P2_has_type ;
    skos:definition "Classification of ritual (puja, jatra, consecration)" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:route_description a owl:DatatypeProperty ;
    rdfs:label "route_description" ;
    rdfs:range xsd:string ;
    skos:definition "Text description of the procession route" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:schema_version a owl:DatatypeProperty ;
    rdfs:label "schema_version" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:selected_person a owl:ObjectProperty ;
    rdfs:label "selected_person" ;
    rdfs:range heritageGraph:Person ;
    skos:definition "Person selected through a ritual selection process to assume a sacred role or office" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:source_citation a owl:DatatypeProperty ;
    rdfs:label "source_citation" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf heritageGraph:note ;
    skos:definition "Formal citation of source" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:source_type a owl:DatatypeProperty ;
    rdfs:label "source_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of source: Manuscript, Inscription, FieldSurvey, PublishedBook, Archive, MuseumCollection, OralHistoryInterview, etc." ;
    skos:inScheme <HeritageGraph> .

heritageGraph:source_url a owl:DatatypeProperty ;
    rdfs:label "source_url" ;
    rdfs:range xsd:string ;
    skos:definition "URL or digital identifier for source" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:start_place a owl:ObjectProperty ;
    rdfs:label "start_place" ;
    rdfs:range heritageGraph:Place ;
    skos:definition "Starting location of movement ritual" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:supersedes_assertion a owl:ObjectProperty ;
    rdfs:label "supersedes_assertion" ;
    rdfs:range heritageGraph:HeritageAssertion ;
    skos:definition "Previous version of this assertion (if this is an update). Creates version chain: A1 → A2 → A3. Query pattern: latest assertion = one with no incoming prov:invalidated" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:syncretic_type a owl:ObjectProperty ;
    rdfs:label "syncretic_type" ;
    rdfs:range heritageGraph:SyncreticTypeEnum ;
    skos:broadMatch crm:P2_has_type ;
    skos:definition "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
    skos:inScheme <HeritageGraph> .

heritageGraph:traditional_role a owl:DatatypeProperty ;
    rdfs:label "traditional_role" ;
    rdfs:range xsd:string ;
    skos:definition "Hereditary occupation or ritual duty" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:transferred_from_actor a owl:ObjectProperty ;
    rdfs:label "transferred_from_actor" ;
    rdfs:range heritageGraph:Actor ;
    skos:definition "Previous custodian" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:transferred_object a owl:ObjectProperty ;
    rdfs:label "transferred_object" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Object transferred in custody event" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:transferred_to_actor a owl:ObjectProperty ;
    rdfs:label "transferred_to_actor" ;
    rdfs:range heritageGraph:Actor ;
    skos:definition "New custodian (person or group)" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:transferred_to_guthi a owl:ObjectProperty ;
    rdfs:label "transferred_to_guthi" ;
    rdfs:range heritageGraph:Guthi ;
    skos:broadMatch crm:P29_custody_received_by ;
    skos:definition "New custodian (Guthi)" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:used_method a owl:DatatypeProperty ;
    rdfs:label "used_method" ;
    rdfs:range xsd:string ;
    skos:definition "Documentation method used" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:verification_method a owl:DatatypeProperty ;
    rdfs:label "verification_method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used for verification (cross-check, expert review, field visit)" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:year_offset_from_gregorian a owl:DatatypeProperty ;
    rdfs:label "year_offset_from_gregorian" ;
    rdfs:range xsd:integer ;
    skos:definition "Mathematical offset to convert to Common Era (e.g., +57 for BS)." ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Consecration a owl:Class ;
    owl:disjointWith heritageGraph:ConditionAssessment ;
    owl:disjointWith heritageGraph:Enshrinement ;
    owl:disjointWith heritageGraph:Festival ;
    owl:disjointWith heritageGraph:Production ;
    owl:disjointWith heritageGraph:TransferOfCustody ;
    rdfs:label "Consecration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:makes_deity_present ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Murti ;
            owl:onProperty heritageGraph:consecrated_object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:consecrated_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:makes_deity_present ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:consecrated_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:makes_deity_present ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ] ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)" ;
    skos:exactMatch heritageGraph:Consecration ;
    skos:inScheme <HeritageGraph> .

heritageGraph:InformationObject a owl:Class ;
    rdfs:label "InformationObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_about_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:is_about_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_about_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:created_by_documentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:created_by_documentation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_about_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_about_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:is_about_event ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:created_by_documentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        heritageGraph:DataSource ;
    skos:definition "A recorded piece of information about heritage" ;
    skos:exactMatch heritageGraph:InformationObject ;
    skos:inScheme <HeritageGraph> .

heritageGraph:LivingGoddessTenure a owl:Class ;
    rdfs:label "LivingGoddessTenure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:embodied_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:residence_structure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:residence_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:had_participant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:supported_by_institution ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:embodied_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:supported_by_institution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_retirement_event ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:LivingGoddessRetirement ;
            owl:onProperty heritageGraph:has_retirement_event ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:had_participant ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:embodied_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:residence_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_retirement_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ] ;
    skos:definition "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families." ;
    skos:exactMatch crm:E4_Period ;
    skos:inScheme <HeritageGraph> .

heritageGraph:RestHouse a owl:Class ;
    owl:disjointWith heritageGraph:BuddhistMonument ;
    owl:disjointWith heritageGraph:Temple ;
    owl:disjointWith heritageGraph:WaterStructure ;
    rdfs:label "RestHouse" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Community structures for travelers and pilgrims, maintained by Guthi organizations" ;
    skos:exactMatch heritageGraph:RestHouse ;
    skos:inScheme <HeritageGraph> .

heritageGraph:created_by_documentation a owl:ObjectProperty ;
    rdfs:label "created_by_documentation" ;
    rdfs:range heritageGraph:DocumentationActivity ;
    owl:inverseOf heritageGraph:produced_information_object ;
    skos:definition "Documentation activity that produced this information object" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:documented_in_source a owl:ObjectProperty ;
    rdfs:label "documented_in_source" ;
    rdfs:range heritageGraph:DataSource ;
    skos:broadMatch prov:wasDerivedFrom ;
    skos:definition "Sources that mention or document this entity" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:ended_tenure_of a owl:ObjectProperty ;
    rdfs:label "ended_tenure_of" ;
    rdfs:range heritageGraph:LivingGoddessTenure ;
    owl:inverseOf heritageGraph:has_retirement_event ;
    skos:definition "Points from a LivingGoddessRetirement event to the tenure that it terminated. Enables reconstruction of complete Living Goddess lifecycle." ;
    skos:inScheme <HeritageGraph> .

heritageGraph:has_condition_assessment a owl:ObjectProperty ;
    rdfs:label "has_condition_assessment" ;
    rdfs:range heritageGraph:ConditionAssessment ;
    skos:definition "Condition assessment events for this structure" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:has_retirement_event a owl:ObjectProperty ;
    rdfs:label "has_retirement_event" ;
    rdfs:range heritageGraph:LivingGoddessRetirement ;
    owl:inverseOf heritageGraph:ended_tenure_of ;
    skos:definition "Retirement event that ended this Living Goddess tenure" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:is_component_of a owl:ObjectProperty ;
    rdfs:label "is_component_of" ;
    rdfs:range heritageGraph:ArchitecturalStructure ;
    owl:inverseOf heritageGraph:has_component ;
    skos:definition "Larger structure that this element is part of" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:is_part_of_festival a owl:ObjectProperty ;
    rdfs:label "is_part_of_festival" ;
    rdfs:range heritageGraph:Festival ;
    owl:inverseOf heritageGraph:includes_ritual_event ;
    skos:definition "Larger festival this ritual is part of" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:participates_in_ritual a owl:ObjectProperty ;
    rdfs:label "participates_in_ritual" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:broadMatch crm:P12i_was_present_at ;
    skos:definition "Rituals in which this structure participates" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:produced_information_object a owl:ObjectProperty ;
    rdfs:label "produced_information_object" ;
    rdfs:range heritageGraph:InformationObject ;
    owl:inverseOf heritageGraph:created_by_documentation ;
    skos:definition "Information object (record, document) produced by documentation" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:produced_object a owl:ObjectProperty ;
    rdfs:label "produced_object" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    owl:inverseOf heritageGraph:was_produced_by_event ;
    skos:definition "Object produced by this production event" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:was_derived_from_source a owl:ObjectProperty ;
    rdfs:label "was_derived_from_source" ;
    rdfs:range heritageGraph:DataSource ;
    skos:definition "Source(s) from which this assertion was derived" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:IconographicObject a owl:Class ;
    owl:disjointWith heritageGraph:ArchitecturalElement ;
    owl:disjointWith heritageGraph:ArchitecturalStructure ;
    rdfs:label "IconographicObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_produced_by_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_current_location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:depicts_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Production ;
            owl:onProperty heritageGraph:was_produced_by_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:participates_in_ritual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:used_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:was_produced_by_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:participates_in_ritual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:depicts_deity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_current_location ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        heritageGraph:HumanMadeObject ;
    skos:broadMatch aat:300264387 ;
    skos:closeMatch crm:E36_Visual_Item ;
    skos:definition "Sacred visual art objects that depict or embody deities through iconographic conventions" ;
    skos:exactMatch dbo:Artwork,
        heritageGraph:IconographicObject ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Production a owl:Class ;
    owl:disjointWith heritageGraph:ConditionAssessment ;
    owl:disjointWith heritageGraph:Consecration ;
    owl:disjointWith heritageGraph:DocumentationActivity ;
    owl:disjointWith heritageGraph:Enshrinement ;
    owl:disjointWith heritageGraph:RitualEvent ;
    owl:disjointWith heritageGraph:TransferOfCustody ;
    rdfs:label "Production" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:HeritageAssertion ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:produced_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Technique ;
            owl:onProperty heritageGraph:used_technique ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used_technique ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty heritageGraph:produced_object ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:produced_object ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:commissioned_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:commissioned_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ] ;
    skos:definition "Event of creating an architectural structure, murti, or paubha" ;
    skos:exactMatch crm:E12_Production ;
    skos:inScheme <HeritageGraph> .

heritageGraph:ReligiousTradition a owl:Class ;
    rdfs:label "ReligiousTradition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ] ;
    skos:definition "Religious or philosophical tradition (e.g., Hindu, Buddhist, Syncretic)" ;
    skos:exactMatch aat:300073708,
        crm:E55_Type ;
    skos:inScheme <HeritageGraph> .

heritageGraph:includes_ritual_event a owl:ObjectProperty ;
    rdfs:label "includes_ritual_event" ;
    rdfs:range heritageGraph:RitualEvent ;
    owl:inverseOf heritageGraph:is_part_of_festival ;
    skos:definition "Component rituals of festival" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:CasteGroup a owl:Class ;
    owl:disjointWith heritageGraph:Deity ;
    owl:disjointWith heritageGraph:Guthi ;
    owl:disjointWith heritageGraph:Person ;
    owl:disjointWith heritageGraph:Place ;
    rdfs:label "CasteGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:traditional_role ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:traditional_role ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:traditional_role ] ;
    skos:broadMatch crm:E74_Group ;
    skos:definition "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    skos:exactMatch heritageGraph:CasteGroup ;
    skos:inScheme <HeritageGraph> .

heritageGraph:ConditionTypeEnum a owl:Class ;
    rdfs:label "ConditionTypeEnum" ;
    owl:unionOf ( heritageGraph:Good heritageGraph:Damaged heritageGraph:Ruined heritageGraph:Restored ) ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values heritageGraph:Damaged,
        heritageGraph:Good,
        heritageGraph:Restored,
        heritageGraph:Ruined .

heritageGraph:Enshrinement a owl:Class ;
    owl:disjointWith heritageGraph:ConditionAssessment ;
    owl:disjointWith heritageGraph:Consecration ;
    owl:disjointWith heritageGraph:Festival ;
    owl:disjointWith heritageGraph:Production ;
    owl:disjointWith heritageGraph:TransferOfCustody ;
    rdfs:label "Enshrinement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_in_structure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:enshrined_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_in_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enshrined_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Temple ;
            owl:onProperty heritageGraph:enshrined_in_structure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ] ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Event of installing a deity's murti or symbol within a temple sanctum" ;
    skos:exactMatch heritageGraph:Enshrinement ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Festival a owl:Class ;
    owl:disjointWith heritageGraph:Consecration ;
    owl:disjointWith heritageGraph:Enshrinement ;
    rdfs:label "Festival" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:includes_ritual_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:includes_ritual_event ],
        heritageGraph:RitualEvent ;
    skos:definition "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
    skos:exactMatch heritageGraph:Festival ;
    skos:inScheme <HeritageGraph> .

heritageGraph:SyncreticTypeEnum a owl:Class ;
    rdfs:label "SyncreticTypeEnum" ;
    owl:unionOf ( heritageGraph:Equivalence heritageGraph:Appropriation heritageGraph:Fusion heritageGraph:Historical ) ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values heritageGraph:Appropriation,
        heritageGraph:Equivalence,
        heritageGraph:Fusion,
        heritageGraph:Historical .

heritageGraph:id a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Globally unique URI identifier" ;
    skos:exactMatch <http://schema.org/identifier> ;
    skos:inScheme <HeritageGraph> .

heritageGraph:performed_by_group a owl:DatatypeProperty ;
    rdfs:label "performed_by_group" ;
    rdfs:range [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] ;
    rdfs:subPropertyOf heritageGraph:carried_out_by ;
    skos:broadMatch crm:P14_carried_out_by ;
    skos:definition "Group (Guthi, caste) responsible for ritual" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:source_language a owl:DatatypeProperty ;
    rdfs:label "source_language" ;
    rdfs:range xsd:string ;
    skos:definition "Language of the source material" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:DatePrecisionEnum a owl:Class ;
    rdfs:label "DatePrecisionEnum" ;
    owl:unionOf ( heritageGraph:Exact heritageGraph:Year heritageGraph:Decade heritageGraph:Century heritageGraph:Circa ) ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values heritageGraph:Century,
        heritageGraph:Circa,
        heritageGraph:Decade,
        heritageGraph:Exact,
        heritageGraph:Year .

heritageGraph:ExistenceStatusEnum a owl:Class ;
    rdfs:label "ExistenceStatusEnum" ;
    owl:unionOf ( heritageGraph:Extant heritageGraph:PartiallyExtant heritageGraph:Destroyed heritageGraph:Lost heritageGraph:Hypothetical heritageGraph:Unknown ) ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values heritageGraph:Destroyed,
        heritageGraph:Extant,
        heritageGraph:Hypothetical,
        heritageGraph:Lost,
        heritageGraph:PartiallyExtant,
        heritageGraph:Unknown .

heritageGraph:has_architectural_style a owl:ObjectProperty ;
    rdfs:label "has_architectural_style" ;
    rdfs:range crm:E55_Type ;
    skos:broadMatch crm:P2_has_type ;
    skos:definition "Architectural style classification",
        "Collection of ArchitecturalStyle instances" ;
    skos:inScheme <HeritageGraph> .

crm:E55_Type a owl:Class ;
    rdfs:label "ArchitecturalStyleEnum" ;
    owl:unionOf ( aat:300004829 aat:300446671 aat:300001285 aat:300007562 aat:300007576 ) ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type." ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values aat:300001285,
        aat:300004829,
        aat:300007562,
        aat:300007576,
        aat:300446671 .

heritageGraph:GuthiTypeEnum a owl:Class ;
    rdfs:label "GuthiTypeEnum" ;
    owl:unionOf ( heritageGraph:SiGuthi heritageGraph:JatraGuthi heritageGraph:PujaGuthi heritageGraph:TempleGuthi heritageGraph:NashaGuthi heritageGraph:SanaGuthi heritageGraph:SanGuthi heritageGraph:RajGuthi ) ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)" ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values heritageGraph:JatraGuthi,
        heritageGraph:NashaGuthi,
        heritageGraph:PujaGuthi,
        heritageGraph:RajGuthi,
        heritageGraph:SanGuthi,
        heritageGraph:SanaGuthi,
        heritageGraph:SiGuthi,
        heritageGraph:TempleGuthi .

heritageGraph:has_current_location a owl:ObjectProperty ;
    rdfs:label "has_current_location" ;
    rdfs:range heritageGraph:Place ;
    owl:inverseOf heritageGraph:contains_structure ;
    skos:definition "Current location of object or structure" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:has_provenance_assertion a owl:ObjectProperty ;
    rdfs:label "has_provenance_assertion" ;
    rdfs:range heritageGraph:HeritageAssertion ;
    skos:definition "All factual claims about this structure with full provenance" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:was_produced_by_event a owl:ObjectProperty ;
    rdfs:label "was_produced_by_event" ;
    rdfs:range heritageGraph:Production ;
    owl:inverseOf heritageGraph:produced_object ;
    skos:definition "Event that created this object or structure" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:DataSource a owl:Class ;
    owl:disjointWith heritageGraph:DocumentationActivity ;
    owl:disjointWith heritageGraph:HeritageAssertion ;
    rdfs:label "DataSource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_citation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:publication_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:datacite_publisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:datacite_identifier_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:publication_timespan ],
        [ a owl:Restriction ;
