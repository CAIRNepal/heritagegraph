{
  "@context": {
    "heritageGraph": "https://w3id.org/heritagegraph/",
    "hg":            "https://heritagegraph.org/",
    "rdfs":          "http://www.w3.org/2000/01/rdf-schema#",
    "xsd":           "http://www.w3.org/2001/XMLSchema#"
  },

  "@graph": [
    {
      "@id":   "hg:festival/indra_jatra",
      "@type": "heritageGraph:Festival",
      "heritageGraph:name": "इन्द्रजात्रा",
      "heritageGraph:has_timespan": {
        "@id":   "hg:festival/indra_jatra/timespan",
        "@type": "heritageGraph:TimeSpan",
        "heritageGraph:date_earliest": { "@value": "1200-01-01", "@type": "xsd:date" }
      },
      "heritageGraph:took_place_at":       { "@id": "hg:place/kathmandu_durbar_square" },
      "heritageGraph:managed_by_guthi":    { "@id": "hg:guthi/kumari_guthi" },
      "heritageGraph:includes_ritual_event": [
        { "@id": "hg:ritual/kumari_procession" },
        { "@id": "hg:ritual/devi_dance" }
      ]
    },

    {
      "@id":   "hg:ritual/kumari_procession",
      "@type": "heritageGraph:RitualEvent",
      "heritageGraph:name": "Kumari Chariot Procession",
      "heritageGraph:ritual_type": "ChariotProcession",
      "heritageGraph:took_place_at": {
        "@id":   "hg:place/kathmandu_durbar_square",
        "@type": "heritageGraph:Place",
        "heritageGraph:name": "Kathmandu Durbar Square"
      },
      "heritageGraph:carried_out_by":   { "@id": "hg:guthi/kumari_guthi" },
      "heritageGraph:is_part_of_festival": { "@id": "hg:festival/indra_jatra" }
    },

    {
      "@id":   "hg:guthi/kumari_guthi",
      "@type": "heritageGraph:Guthi",
      "heritageGraph:name": "कुमारी गुठी"
    }
  ]
}
