# ================================================================
# HeritageGraph .gitignore
# ================================================================

# ==================== Python ====================
venv/
.venv/
myenv/
.myenv/
.myvenv/
.myvenv/*
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ==================== Node.js ====================
node_modules/
**/.next/**
.turbo/
*.tsbuildinfo

# ==================== Environment ====================
*.env*
!.env.example

# ==================== Logs ====================
data/*.log
*.log
.dev-logs/
.dev-backend.log
.dev-frontend.log

# ==================== Tool caches ====================
.ruff_cache/
.pytest_cache/
.mypy_cache/
.claude/

# ==================== Data ====================
# Anchor to repo root so app source dirs like landing/src/data/ remain trackable.
/data/
documentation/research/_*.local.json
heritage_graph/db.sqlite3.bak-*

# ==================== Runtime RDF store ====================
# Embedded pyoxigraph RocksDB store — a runtime database, not source.
# Rebuildable with `make rdf-rebuild`. Must not be tracked (causes huge,
# churning diffs from RocksDB compaction). Untrack once with:
#   git rm -r --cached oxigraph_db
/oxigraph_db/

# Generated LOD exports (rebuild via manage.py / make targets)
/ontology/lod/nanopubs/
/ontology/lod/dumps/
/ontology/lod/annotations.trig
/evaluation/reports/latest.json
/evaluation/reports/inference.json

# ==================== Docker ====================
infra/traefik/acme/acme.json
backups/
# Local override for Fuseki admin password / extra env (see FUSEKI.md)
docker-compose.fuseki.local.yml

# ==================== IDE ====================
.vscode/
.idea/
*.swp
*.swo
*~

# ==================== OS ====================
.DS_Store
Thumbs.db

# ==================== Documentation ====================
# /docs/*
# !/docs/
# !/docs/.gitkeep
# !/docs/api/**
# !/docs/static/**
# !/docs/en/**

# ==================== Spec Kit / tools ====================
.specify/extensions/.cache/
# Generated MkDocs output (build artifact, rebuild with `mkdocs build`)
/site/

# ==================== Evaluation artifacts ====================
# Generated by `manage.py kg_evaluate` / `kg_quality_report` /
# `kg_materialize_inference`. These are measurements of one machine at one
# moment; committing them lets a stale or non-reportable run be quoted as a
# result. Regenerate locally (see evaluation/README.md); publish the reportable
# run with the Zenodo deposit, not in git.
/evaluation/reports/*.json
/evaluation/reports/*.log

# Isolated build output (NEXT_DIST_DIR), so a verification or CI build can
# run alongside a live `next dev` without either clobbering the other.
**/.next-*/
**/.next-*/**
