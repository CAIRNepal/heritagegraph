    given-names: Nabin
    affiliation: "CAIR-Nepal"
  - family-names: Karki
    given-names: Niraj
    affiliation: "CAIR-Nepal"
  - name: "CAIR-Nepal"
repository-code: "https://github.com/CAIRNepal/CHLOD"
url: "https://cairnepal.github.io/heritagegraph/"
keywords:
  - cultural heritage
  - linked open data
  - knowledge graph
  - CIDOC-CRM
  - SPARQL
  - digital humanities
