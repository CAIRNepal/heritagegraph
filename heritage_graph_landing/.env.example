# Django API (no trailing slash) — required for discovery + record pages
NEXT_PUBLIC_API_URL=http://localhost:8000

# Main Next.js app (dashboard) — sign-in, contribute, graph links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: when inferring app URL from localhost without NEXT_PUBLIC_APP_URL
# NEXT_PUBLIC_APP_DEV_PORT=3000
